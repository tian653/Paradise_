# ─── Database (Turso) ─────────────────────────────────────────────────────────
# Get these from: https://turso.tech/app → your database → settings
DATABASE_URL="libsql://your-db-name.turso.io"
DATABASE_AUTH_TOKEN="your-turso-auth-token"

# ─── JWT ──────────────────────────────────────────────────────────────────────
# Generate a strong random secret: openssl rand -base64 48
JWT_SECRET="replace-with-a-long-random-string"

# ─── Cloudinary (image storage) ───────────────────────────────────────────────
# Get these from: https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"

# ─── CORS (production only) ───────────────────────────────────────────────────
# Set this to your frontend's Vercel URL to restrict CORS origin
FRONTEND_URL="https://your-app.vercel.app"

# ─── Admin Account ────────────────────────────────────────────────────────────
# Credentials are hardcoded in apps/server/src/db/seed.ts
# Run: npm run db:migrate   to create tables
# Run: npm run db:seed      to create the admin account
